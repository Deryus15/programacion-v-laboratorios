<mxfile host="app.diagrams.net"><diagram name="Arquitectura G2 Parqueo"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="persona" value="Conductor / Operador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="220" height="70" as="geometry"/></mxCell><mxCell id="pagina" value="PÁGINA DEL GRUPO&lt;br&gt;(navegador)&lt;br&gt;&lt;br&gt;entrada.html → registrar entrada&lt;br&gt;salida.html  → cobro y estado&lt;br&gt;panel.html   → dentro y barrera&lt;br&gt;app.js (fetch)&lt;br&gt;&lt;br&gt;Solo habla con el&lt;br&gt;servidor del grupo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="260" height="330" as="geometry"/></mxCell><mxCell id="billetera" value="APP BILLETERA (PagaYa)&lt;br&gt;celular del conductor&lt;br&gt;Aquí el cliente aprueba o rechaza&lt;br&gt;el pago con su PIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="395" width="380" height="110" as="geometry"/></mxCell><mxCell id="servidor" value="SERVIDOR DEL GRUPO  ·  Java 8  ·  puerto 8081" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#15803d;strokeWidth=2;fontSize=11;fontStyle=1;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="370" y="30" width="620" height="760" as="geometry"/></mxCell><mxCell id="ctrl" value="CAPA CONTROLLER&lt;br&gt;TicketController   SalidaController   BarreraController&lt;br&gt;ManejadorBase · Peticion · Respuesta · Validador · Json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="80" width="580" height="120" as="geometry"/></mxCell><mxCell id="svc" value="CAPA SERVICE  (reglas del negocio)&lt;br&gt;TicketService  SalidaService  TarifaService  BarreraService&lt;br&gt;TarifaService: fracciones de 30 min con tope diario&lt;br&gt;BarreraService: abre SOLO con el cobro PAGADO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="230" width="580" height="140" as="geometry"/></mxCell><mxCell id="integ" value="CAPA INTEGRACIÓN&lt;br&gt;PagaYaCliente  (X-Api-Key · Idempotency-Key&lt;br&gt;traduce errores de PagaYa; timeout → 503)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#b45309;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="400" width="580" height="110" as="geometry"/></mxCell><mxCell id="repo" value="CAPA REPOSITORY  (JDBC · PreparedStatement)&lt;br&gt;TicketRepository   TarifaRepository&lt;br&gt;BarreraEventoRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="540" width="580" height="110" as="geometry"/></mxCell><mxCell id="conf" value="config.properties  (NO va a Git)&lt;br&gt;pagaya.url · pagaya.apikey · db.url · db.user&lt;br&gt;(se entrega config.ejemplo.properties)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="680" width="580" height="90" as="geometry"/></mxCell><mxCell id="db" value="BASE DE DATOS PROPIA&lt;br&gt;MySQL / MariaDB  ·  3306&lt;br&gt;parqueo_db&lt;br&gt;&lt;br&gt;tarifa&lt;br&gt;ticket  (placa, cobro_pagaya, estado)&lt;br&gt;evento_barrera" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#6d28d9;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="560" width="380" height="220" as="geometry"/></mxCell><mxCell id="pagaya" value="PAGAYA  ·  puerto 8080&lt;br&gt;(servidor del docente)&lt;br&gt;&lt;br&gt;POST /api/cobros&lt;br&gt;GET  /api/cobros/{id}&lt;br&gt;POST /api/cobros/{id}/reembolso&lt;br&gt;POST /api/cobros/{id}/anular&lt;br&gt;POST /api/billetera/..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="60" width="380" height="270" as="geometry"/></mxCell><mxCell id="e0" value="usa" style="endArrow=block;html=1;strokeColor=#444444;strokeWidth=2;fontSize=10;fontColor=#444444;" edge="1" parent="1" source="persona" target="pagina"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="HTTP / JSON  :8081" style="endArrow=block;html=1;strokeColor=#1d4ed8;strokeWidth=2;fontSize=10;fontColor=#1d4ed8;" edge="1" parent="1" source="pagina" target="ctrl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;strokeColor=#15803d;strokeWidth=2;fontSize=10;fontColor=#15803d;" edge="1" parent="1" source="ctrl" target="svc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="endArrow=block;html=1;strokeColor=#15803d;strokeWidth=2;fontSize=10;fontColor=#15803d;" edge="1" parent="1" source="svc" target="integ"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;strokeColor=#15803d;strokeWidth=2;fontSize=10;fontColor=#15803d;" edge="1" parent="1" source="svc" target="repo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="HTTP :8080  X-Api-Key&lt;br&gt;Idempotency-Key" style="endArrow=block;html=1;strokeColor=#b45309;strokeWidth=2;fontSize=10;fontColor=#b45309;" edge="1" parent="1" source="integ" target="pagaya"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="JDBC :3306" style="endArrow=block;html=1;strokeColor=#6d28d9;strokeWidth=2;fontSize=10;fontColor=#6d28d9;" edge="1" parent="1" source="repo" target="db"><mxGeometry relative="1" as="geometry"/></mxC