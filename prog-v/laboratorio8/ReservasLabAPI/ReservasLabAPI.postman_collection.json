{
  "info": {
    "name": "ReservasLabAPI - Semana 10",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "apiKey",
      "value": "unachi-prog5"
    }
  ],
  "item": [
    {
      "name": "RF-01 Listar reservas (200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reservas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reservas"
          ]
        }
      }
    },
    {
      "name": "RF-03 Crear reserva válida (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-KEY",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reservas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reservas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"laboratorio\": \"LAB-3\", \"solicitante\": \"Ana Pérez\", \"fecha\": \"2026-10-24\", \"horaInicio\": \"08:00\", \"horaFin\": \"10:00\"}"
        }
      }
    },
